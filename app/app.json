{
  "expo": {
    "name": "拾光",
    "slug": "timescavenger",
    "scheme": "timescavenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.augustone.timescavenger",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "随机回顾与整理需要访问你的照片库；所有处理仅在本机完成，不会上传任何照片。"
      }
    },
    "plugins": [
      "expo-image",
      "expo-video",
      "expo-sqlite",
      "expo-router",
      "expo-splash-screen"
    ]
  }
}
